// 1. GENERATOR PRISMA CLIENT
generator client {
  provider = "prisma-client-js"
}

// 2. DATASOURCE DATABASE
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 3. MODEL ADMIN (PENTING: Agar tabel Admin & data login tidak terhapus!)
model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

// 4. MODEL NEWS (Ditingkatkan untuk mendukung multiple foto)
model News {
  id        Int      @id @default(autoincrement())
  title     String
  date      String
  images    String[] // 🟢 DIUBAH: Menggunakan array string untuk menampung banyak foto
  excerpt   String
  content   String   @db.Text
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

// 5. MODEL TEACHER
model Teacher {
  id        Int      @id @default(autoincrement())
  name      String
  position  String
  photo     String?  // Opsional untuk URL Vercel Blob
  createdAt DateTime @default(now())
}

// 6. MODEL GALLERY
model Gallery {
  id        Int      @id @default(autoincrement())
  title     String
  image     String?  // Opsional untuk URL Vercel Blob
  published Boolean  @default(false)
  createdAt DateTime @default(now())
}