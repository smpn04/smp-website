import { NextRequest, NextResponse } from "next/server";

export function middleware(request: NextRequest) {
  const { pathname } = request.nextUrl;
  const token = request.cookies.get("admin")?.value;

  // 1. Jika mencoba akses halaman admin (selain /admin/login)
  if (pathname.startsWith("/admin") && pathname !== "/admin/login") {
    if (!token) {
      // Redirect ke login jika belum ada cookie token
      return NextResponse.redirect(new URL("/admin/login", request.url));
    }
  }

  // 2. Jika sudah login tetapi mencoba buka halaman /admin/login lagi, lempar balik ke dashboard
  if (pathname === "/admin/login" && token) {
    return NextResponse.redirect(new URL("/admin/berita", request.url));
  }

  return NextResponse.next();
}

// MATCHING FILTER: Kecualikan file statis, gambar, dan aset internal Next.js agar tidak kena intercept middleware
export const config = {
  matcher: [
    /*
     * Match all request paths except for the ones starting with:
     * - api (API routes, biarkan dihandle API handler sendiri)
     * - _next/static (static files)
     * - _next/image (image optimization files)
     * - favicon.ico (favicon file)
     */
    "/((?!api|_next/static|_next/image|favicon.ico).*)",
  ],
};